# Copy to .env and adjust. Never commit .env.

# SQLite database file. Leave empty to use backend/instance/expenses.db
DATABASE_PATH=

# AI assistant mode:
#   auto      - use Claude if ANTHROPIC_API_KEY is set, otherwise the offline rule-based assistant
#   anthropic - always try Claude (falls back to rules if the API call fails)
#   rules     - never call an external API
AI_PROVIDER=auto

# Get a key from https://console.anthropic.com/ (optional; the app works without it)
ANTHROPIC_API_KEY=
# Any Messages API model that supports tool use. claude-haiku-4-5-20251001 is a cheaper option.
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_TIMEOUT_SECONDS=30

# Development server
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=0
